# Copy to /opt/muse-proxy/.env on the VM (chmod 600). Never commit the real file.
MP_DOMAIN=muse.example.com
ACME_EMAIL=you@example.com

# Optional web admin at https://<MP_DOMAIN>/admin, signed in with a passkey (see docs/DEPLOY.md "Web admin").
# Passkeys are added with `mp admin-enroll`. MP_ADMIN_EMAIL is only the passkey's user name and the name shown in the UI.
MP_ADMIN_ENABLED=false
MP_ADMIN_EMAIL=you@example.com
# MP_ADMIN_SESSION_HOURS=12
# MP_ADMIN_ENROLL_MINUTES=15

# Optional: ntfy-style URL POSTed when Muse has been disconnected for 30+ minutes,
# e.g. https://ntfy.sh/<long-random-topic>
MP_ALERT_URL=
MP_DISCONNECT_ALERT_MINUTES=30

# Optional tuning (defaults shown)
# MP_MAX_MESSAGE_BYTES=10485760
# MP_ALIAS_DAILY_LIMIT=50
# Forwarders whose ARC seal can vouch for DMARC when forwarding breaks it (comma-separated)
# MP_ARC_TRUSTED_SEALERS=google.com,microsoft.com,outlook.com,protonmail.ch,proton.me,messagingengine.com,fastmail.com,icloud.com,yahoo.com
# MP_EVENT_RETENTION_DAYS=30
# MP_MAIL_RETENTION_DAYS=30
